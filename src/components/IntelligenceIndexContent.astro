---
import FullBleedHero from "./FullBleedHero.astro";
import FullBleedBreak from "./FullBleedBreak.astro";
import ElectricDivider from "./decor/ElectricDivider.astro";
import AnimatedBattery from "./decor/AnimatedBattery.astro";
import { statsContent } from "../i18n/statsContent";
import type { Locale } from "../i18n/config";
import { withBase } from "../lib/url";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = statsContent[locale];

const global: Array<[string, string]> = [
  [t.g1Number, t.g1Label],
  [t.g2Number, t.g2Label],
  [t.g3Number, t.g3Label],
  [t.g4Number, t.g4Label],
];

const opportunity: Array<[string, string, string]> = [
  ["17%", t.opp1Label, t.opp1Source],
  ["53.9%", t.opp2Label, t.opp2Source],
  ["93", t.opp3Label, t.opp3Source],
];

const forecast: Array<[string, string]> = [
  [t.f1Number, t.f1Label],
  [t.f2Number, t.f2Label],
  [t.f3Number, t.f3Label],
  [t.f4Number, t.f4Label],
];

const segment: Array<[string, string]> = [
  [t.sg1Number, t.sg1Label],
  [t.sg2Number, t.sg2Label],
  [t.sg3Number, t.sg3Label],
  [t.sg4Number, t.sg4Label],
];

const signals: Array<[string, string]> = [
  [t.sig1Heading, t.sig1Text],
  [t.sig2Heading, t.sig2Text],
  [t.sig3Heading, t.sig3Text],
  [t.sig4Heading, t.sig4Text],
  [t.sig5Heading, t.sig5Text],
];

const tailwinds: Array<[string, string, string]> = [
  [t.d0Heading, t.d0Geo, t.d0Timeline],
  [t.d1Heading, t.d1Geo, t.d1Timeline],
  [t.d2Heading, t.d2Geo, t.d2Timeline],
  [t.d3Heading, t.d3Geo, t.d3Timeline],
  [t.d4Heading, t.d4Geo, t.d4Timeline],
  [t.d5Heading, t.d5Geo, t.d5Timeline],
];

const restraints: Array<[string, string, string]> = [
  [t.r1Heading, t.r1Geo, t.r1Timeline],
  [t.r2Heading, t.r2Geo, t.r2Timeline],
  [t.r3Heading, t.r3Geo, t.r3Timeline],
  [t.r4Heading, t.r4Geo, t.r4Timeline],
];

const leaders = ["Nissan Motor Co., Ltd.", "Volkswagen AG", "Tesla Inc.", "BYD Co. Ltd.", "Hyundai Motor Co."];

const advice: Array<[string, string]> = [
  [t.adv1Heading, t.adv1Text],
  [t.adv2Heading, t.adv2Text],
  [t.adv3Heading, t.adv3Text],
];

const rwandaGrid: Array<[string, string]> = [
  [t.rw1Number, t.rw1Label],
  [t.rw2Number, t.rw2Label],
  [t.rw3Number, t.rw3Label],
  [t.rw4Number, t.rw4Label],
];

const ecosystem: Array<[string, string]> = [
  [t.e1Number, t.e1Label],
  [t.e2Number, t.e2Label],
  [t.e3Number, t.e3Label],
  [t.e4Number, t.e4Label],
];

interface Player {
  name: string;
  location: string;
  url: string;
  desc: string;
  logo?: string;
}

const homegrownPlayers: Player[] = [
  { name: "BasiGo", location: "Kenya & Rwanda", url: "https://basigo.co", desc: t.p2Desc, logo: "/logos/basigo.png" },
  { name: "Spiro", location: "Multi-country", url: "https://spiro.co", desc: t.p7Desc, logo: "/logos/spiro.png" },
  { name: "Ampersand", location: "Rwanda & Kenya", url: "https://ampersand.solar", desc: t.p3Desc, logo: "/logos/ampersand.png" },
  { name: "Roam", location: "Kenya", url: "https://roam.africa", desc: t.p1Desc, logo: "/logos/roam.png" },
];

const globalPlayers: Player[] = [
  { name: "BYD", location: "China", url: "https://www.byd.com", desc: t.p4Desc },
  { name: "Tesla", location: "USA", url: "https://www.tesla.com", desc: t.p5Desc },
  { name: "Hyundai & Volkswagen", location: "Global", url: "https://www.hyundai.com", desc: t.p6Desc },
];

const spotlight: Array<[string, string]> = [
  ["17,000", t.sp1Label],
  ["7", t.sp2Label],
  ["100", t.sp3Label],
  ["200+", t.sp4Label],
];

const prices: Array<[string, string, number]> = [
  [t.priceEntryLabel, t.priceEntryRange, 45],
  [t.priceMidLabel, t.priceMidRange, 67],
  [t.pricePremiumLabel, t.pricePremiumRange, 100],
];
---

<FullBleedHero title={t.heroTitle} image="/hero/intelligence.jpg" imageAlt="A row of electric vehicles charging at a multi-bay public station" eyebrow={t.heroEyebrow}>
  <p class="text-lg text-text">{t.heroIntro}</p>
</FullBleedHero>

<section class="bg-paper-warm">
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.globalEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.globalHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.globalIntro}</p>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {global.map(([number, label]) => (
        <div>
          <p class="font-accentSerif text-4xl italic text-ink sm:text-5xl">{number}</p>
          <span class="stat-bar mt-3 block h-0.5 w-12 bg-accent"></span>
          <p class="mt-3 max-w-[22rem] text-text">{label}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-prose text-sm text-text-muted">{t.globalNote}</p>
    <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.globalSource}</p>
  </div>
</section>

<section>
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <div class="flex items-center gap-3">
      <p class="eyebrow">{t.opportunityHeading}</p>
      <AnimatedBattery />
    </div>
    <div class="mt-6 grid gap-8 sm:grid-cols-3 sm:gap-6">
      {opportunity.map(([number, label, source]) => (
        <div>
          <p class="font-accentSerif text-5xl italic text-ink sm:text-6xl">{number}</p>
          <span class="stat-bar mt-3 block h-0.5 w-12 bg-accent"></span>
          <p class="mt-3 max-w-[22rem] text-text">{label}</p>
          <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{source}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="bg-paper-warm">
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.forecastEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.forecastHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.forecastIntro}</p>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {forecast.map(([number, label]) => (
        <div>
          <p class="font-accentSerif text-4xl italic text-ink sm:text-5xl">{number}</p>
          <span class="stat-bar mt-3 block h-0.5 w-12 bg-accent"></span>
          <p class="mt-3 max-w-[22rem] text-text">{label}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.forecastSource}</p>
  </div>
</section>

<section>
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.segmentEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.segmentHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.segmentIntro}</p>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {segment.map(([number, label]) => (
        <div>
          <p class="font-accentSerif text-4xl italic text-ink sm:text-5xl">{number}</p>
          <span class="stat-bar mt-3 block h-0.5 w-12 bg-accent"></span>
          <p class="mt-3 max-w-[22rem] text-text">{label}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.segmentSource}</p>
  </div>
</section>

<FullBleedBreak image="/hero/standards.jpg" imageAlt="A motorcycle taxi rider using a ROAM fast charger in Kenya" toWarm />

<section class="bg-paper-warm">
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.spotlightEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.spotlightHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.spotlightIntro}</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {spotlight.map(([number, label]) => (
        <div class="rounded-lg border border-rule bg-paper p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/70 hover:shadow-lg hover:shadow-accent/20">
          <p class="font-accentSerif text-3xl italic text-ink">{number}</p>
          <p class="mt-2 text-sm text-text-muted">{label}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.spotlightSource}</p>
  </div>
</section>

<section>
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.signalsEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.signalsHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.signalsIntro}</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {signals.map(([heading, text]) => (
        <div class="rounded-lg border border-rule bg-paper-warm p-5">
          <p class="font-sans font-semibold text-ink">{heading}</p>
          <p class="mt-2 text-sm text-text">{text}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.signalsSource}</p>
  </div>
</section>

<section class="bg-paper-warm">
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.tailwindsEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.tailwindsHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.tailwindsIntro}</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {tailwinds.map(([heading, geo, timeline]) => (
        <div class="rounded-lg border border-accent/30 bg-paper p-5">
          <p class="font-sans font-semibold text-ink">{heading}</p>
          <dl class="mt-3 space-y-1.5 font-mono text-xs uppercase tracking-[0.08em] text-text-muted">
            <div class="flex justify-between gap-4">
              <dt>{t.restraintsGeoLabel}</dt>
              <dd class="text-right normal-case tracking-normal text-text">{geo}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt>{t.restraintsTimelineLabel}</dt>
              <dd class="text-right normal-case tracking-normal text-text">{timeline}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.tailwindsSource}</p>
  </div>
</section>

<section>
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.restraintsEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.restraintsHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.restraintsIntro}</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {restraints.map(([heading, geo, timeline]) => (
        <div class="rounded-lg border border-rule bg-paper p-5">
          <p class="font-sans font-semibold text-ink">{heading}</p>
          <dl class="mt-3 space-y-1.5 font-mono text-xs uppercase tracking-[0.08em] text-text-muted">
            <div class="flex justify-between gap-4">
              <dt>{t.restraintsGeoLabel}</dt>
              <dd class="text-right normal-case tracking-normal text-text">{geo}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt>{t.restraintsTimelineLabel}</dt>
              <dd class="text-right normal-case tracking-normal text-text">{timeline}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.restraintsSource}</p>
  </div>
</section>

<section class="bg-paper-warm">
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.leadersEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.leadersHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.leadersIntro}</p>
    <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {leaders.map((name, i) => (
        <li class="flex items-center gap-3 rounded-lg border border-rule bg-paper px-4 py-3">
          <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-accent/15 font-mono text-xs text-accent">{i + 1}</span>
          <span class="font-sans text-sm text-ink">{name}</span>
        </li>
      ))}
    </ol>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.leadersSource}</p>
  </div>
</section>

<ElectricDivider />
<section>
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.costsEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.costsHeading}</h2>
    <div class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-6">
      <div>
        <p class="font-accentSerif text-5xl italic text-ink sm:text-6xl">{t.cost1Number}</p>
        <p class="mt-3 max-w-[22rem] text-text">{t.cost1Label}</p>
        <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.cost1Source}</p>
      </div>
      <div>
        <p class="font-accentSerif text-5xl italic text-ink sm:text-6xl">{t.cost2Number}</p>
        <p class="mt-3 max-w-[22rem] text-text">{t.cost2Label}</p>
        <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.cost2Source}</p>
      </div>
      <div>
        <p class="font-accentSerif text-5xl italic text-ink sm:text-6xl">{t.cost3Number}</p>
        <p class="mt-3 max-w-[22rem] text-text">{t.cost3Label}</p>
        <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.cost3Source}</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-paper-warm">
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.pricesEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.pricesHeading}</h2>
    <div class="mt-8 max-w-2xl space-y-6">
      {prices.map(([label, range, pct]) => (
        <div>
          <div class="flex items-baseline justify-between font-sans text-sm">
            <span class="font-semibold text-ink">{label}</span>
            <span class="text-text-muted">{range}</span>
          </div>
          <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-paper">
            <div class="price-bar h-full rounded-full bg-accent" style={`--bar-width: ${pct}%`}></div>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.pricesSource}</p>
  </div>
</section>

<section>
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.adviceEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.adviceHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.adviceIntro}</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {advice.map(([heading, text], i) => (
        <div class="rounded-lg border border-accent/30 bg-paper-warm p-5">
          <span class="font-accentSerif text-2xl italic text-accent">{i + 1}</span>
          <p class="mt-2 font-sans font-semibold text-ink">{heading}</p>
          <p class="mt-2 text-sm text-text">{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="bg-paper-warm">
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.rwandaEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.rwandaHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.rwandaIntro}</p>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {rwandaGrid.map(([number, label]) => (
        <div>
          <p class="font-accentSerif text-4xl italic text-ink sm:text-5xl">{number}</p>
          <span class="stat-bar mt-3 block h-0.5 w-12 bg-accent"></span>
          <p class="mt-3 max-w-[22rem] text-text">{label}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-prose text-text">{t.rwandaStandardsNote}</p>
    <p class="mt-4 max-w-prose text-sm text-text-muted">{t.rwandaFinanceNote}</p>
    <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">
      <a href="https://blogs.worldbank.org/en/energy/rwanda-electric-mobility" target="_blank" rel="noopener noreferrer" class="hover:text-accent hover:underline">
        {t.rwandaSource}
      </a>
    </p>
    <p class="mt-4 font-sans text-xs text-text-muted">
      {t.rwandaFurtherReading}
      {" "}
      <a href="https://www.esmap.org/Enabling-E-Mobility-in-Rwanda" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
        {t.rwandaEsmapLink}
      </a>
      {" · "}
      <a href="https://www.worldbank.org/en/news/press-release/2025/09/30/building-the-energy-foundations-for-rwanda-s-electric-mobility-transition" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
        {t.rwandaPressLink}
      </a>
    </p>
  </div>
</section>

<section>
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.ecosystemEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.ecosystemHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.ecosystemIntro}</p>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {ecosystem.map(([number, label]) => (
        <div>
          <p class="font-accentSerif text-4xl italic text-ink sm:text-5xl">{number}</p>
          <span class="stat-bar mt-3 block h-0.5 w-12 bg-accent"></span>
          <p class="mt-3 max-w-[22rem] text-text">{label}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-prose text-sm text-text-muted">{t.ecosystemNote}</p>
    <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.ecosystemSource}</p>
  </div>
</section>

<section class="bg-paper-warm">
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.playersEyebrow}</p>
    <h2 class="mt-3 font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.playersHeading}</h2>
    <p class="mt-3 max-w-prose text-text">{t.playersIntro}</p>

    <h3 class="mt-10 font-sans text-sm font-semibold uppercase tracking-[0.08em] text-text-muted">{t.playersHomegrownLabel}</h3>
    <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {homegrownPlayers.map((p) => (
        <div class="rounded-lg border border-rule bg-paper p-5" itemscope itemtype="https://schema.org/Organization">
          {p.logo && (
            <div class="inline-flex rounded-md bg-white px-3 py-2">
              <img src={withBase(p.logo)} alt={`${p.name} logo`} class="h-6 w-auto max-w-[8rem] object-contain" itemprop="logo" loading="lazy" />
            </div>
          )}
          <div class="mt-3 flex items-baseline justify-between gap-2">
            <p class="font-sans text-lg font-semibold text-ink" itemprop="name">{p.name}</p>
            <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-muted">{p.location}</span>
          </div>
          <p class="mt-2 text-sm text-text">{p.desc}</p>
          <a
            href={p.url}
            itemprop="url"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block font-mono text-xs uppercase tracking-[0.08em] text-accent hover:underline"
          >
            {t.visitSiteLabel}: {p.name} →
          </a>
        </div>
      ))}
    </div>
    <p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] text-text-muted">{t.rankingSource}</p>

    <h3 class="mt-10 font-sans text-sm font-semibold uppercase tracking-[0.08em] text-text-muted">{t.playersGlobalLabel}</h3>
    <div class="mt-4 grid gap-5 sm:grid-cols-3">
      {globalPlayers.map((p) => (
        <div class="rounded-lg border border-rule bg-paper p-5" itemscope itemtype="https://schema.org/Organization">
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-sans text-lg font-semibold text-ink" itemprop="name">{p.name}</p>
            <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-muted">{p.location}</span>
          </div>
          <p class="mt-2 text-sm text-text">{p.desc}</p>
          <a
            href={p.url}
            itemprop="url"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block font-mono text-xs uppercase tracking-[0.08em] text-accent hover:underline"
          >
            {t.visitSiteLabel}: {p.name} →
          </a>
        </div>
      ))}
    </div>

    <p class="mt-8 max-w-prose font-mono text-[11px] leading-relaxed text-text-muted">{t.logoCredit}</p>
  </div>
</section>

<section class="mx-auto max-w-content px-6 py-10 md:py-16">
