---
import FullBleedHero from "./FullBleedHero.astro";
import { homeContent } from "../i18n/homeContent";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeContent[locale];
---

<FullBleedHero
  title={t.heroTitle}
  image="/hero/home.jpg"
  imageAlt="Kigali Convention Centre lit at dusk, an aerial view of Rwanda's capital"
  eyebrow={t.heroEyebrow}
>
  <Fragment slot="title">African <em>Charging</em> Alliance</Fragment>
  <p class="text-lg text-text">{t.heroP1}</p>
  <p class="mt-4 text-text">{t.heroP2}</p>
</FullBleedHero>

<div class="mx-auto max-w-content px-6">
  <a href="#initiatives" class="mb-4 hidden items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-text-muted no-underline hover:text-accent md:flex md:w-fit">
    {t.scroll}
    <span class="scroll-cue-arrow flex h-6 w-6 items-center justify-center rounded-full border border-rule">
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </a>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue-arrow {
      animation: scroll-cue-bounce 1.8s ease-in-out infinite;
    }
  }
  @keyframes scroll-cue-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
</style>
