---
import { ui, type Locale } from "../i18n/config";
import { homeContent } from "../i18n/homeContent";
import { withBase } from "../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const h = homeContent[locale];
const year = new Date().getFullYear();
---

<footer class="bg-paper-warm">
  <div class="mx-auto max-w-content px-6 py-12">
    <div class="grid gap-10 font-sans text-sm md:grid-cols-2">
      <div>
        <div class="flex items-center gap-2.5">
          <img src={withBase("/logo.png")} alt="" width="24" height="24" class="h-6 w-6" />
          <p class="font-semibold text-ink">African Charging Alliance</p>
        </div>
        <p class="mt-2 max-w-prose text-text-muted">{t.footer.tagline}</p>
      </div>
      <div>
        <p class="text-xs text-text-muted">&copy; {year} African Charging Alliance.</p>
      </div>
    </div>
    <p class="mt-8 text-[11px] text-text-muted">{h.heroEyebrow}</p>
  </div>
</footer>
