---
import { homeContent } from "../i18n/homeContent";
import DotGridCanvas from "./DotGridCanvas.astro";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeContent[locale];

const initiatives: Array<[string, string]> = [
  [t.init1Title, t.init1Body],
  [t.init2Title, t.init2Body],
  [t.init3Title, t.init3Body],
  [t.init4Title, t.init4Body],
];
---

<section id="initiatives" class="relative scroll-mt-20 overflow-hidden bg-paper-warm">
  <DotGridCanvas class="pointer-events-none absolute inset-0 opacity-30" />
  <div class="reveal relative mx-auto max-w-content px-6 py-10 md:py-16">
    <h2 class="inline-block font-sans text-2xl font-semibold text-ink">
      {t.initiativesHeading}
      <svg class="mt-1 w-full" height="6" viewBox="0 0 120 6" fill="none" aria-hidden="true">
        <path d="M2 4C15 1 25 1 38 4C51 7 61 7 74 4C87 1 97 1 110 4" stroke="#E0924A" stroke-width="2" stroke-linecap="round" />
      </svg>
    </h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {initiatives.map(([title, body]) => (
        <div class="group rounded-lg border border-rule bg-paper p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/70 hover:shadow-lg hover:shadow-accent/20">
          <h3 class="font-sans font-semibold text-ink">{title}</h3>
          <p class="mt-2 text-sm text-text-muted">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
