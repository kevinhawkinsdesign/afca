---
import { reportUi } from "../i18n/intelligenceContent";
import type { Locale } from "../i18n/config";

interface Props {
  scopeNote: string;
  methodologyVersion: string;
  locale?: Locale;
}
const { scopeNote, methodologyVersion, locale = "en" } = Astro.props;
const t = reportUi[locale];
---

<aside class="scope-note" aria-label={t.scopeNote}>
  <p class="mb-1 font-sans font-semibold text-ink">{t.scopeNote} &middot; {t.methodology} v{methodologyVersion}</p>
  <p>{scopeNote}</p>
</aside>
