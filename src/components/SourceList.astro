---
import { reportUi } from "../i18n/intelligenceContent";
import type { Locale } from "../i18n/config";

interface Source {
  label: string;
  url?: string;
  accessed: Date;
}
interface Props {
  sources: Source[];
  locale?: Locale;
}
const { sources, locale = "en" } = Astro.props;
const t = reportUi[locale];
const dateLocale = locale === "en" ? "en-GB" : locale === "fr" ? "fr-FR" : locale === "sv" ? "sv-SE" : "en-GB";
---

{sources.length > 0 && (
  <section class="mt-12 border-t border-rule pt-6 font-sans text-sm" aria-label={t.sources}>
    <h2 class="mb-3 text-base font-semibold text-ink">{t.sources}</h2>
    <ol class="space-y-1.5 text-text-muted">
      {sources.map((s) => (
        <li>
          {s.url ? <a href={s.url} class="text-ink">{s.label}</a> : <span>{s.label}</span>}
          {" "}&middot; {t.accessed} {s.accessed.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" })}
        </li>
      ))}
    </ol>
  </section>
)}
