---
import ElectricDivider from "./decor/ElectricDivider.astro";
import SketchArrow from "./decor/SketchArrow.astro";
import { homeContent } from "../i18n/homeContent";
import { localizePath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeContent[locale];
---

<ElectricDivider />
<section>
  <div class="reveal relative mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="eyebrow">{t.missionEyebrow}</p>
    <h2 class="mt-3 max-w-2xl font-sans text-2xl font-semibold text-ink sm:text-3xl">{t.missionHeading}</h2>
    <p class="mt-5 max-w-prose text-text">{t.missionBody}</p>
    <span class="relative mt-6 inline-block">
      <a href={localizePath("/about", locale)} class="eyebrow inline-flex items-center gap-2 no-underline hover:text-ink">
        {t.missionCta}
        <span aria-hidden="true">&rarr;</span>
      </a>
      <SketchArrow class="absolute -right-20 top-1/2 hidden -translate-y-1/2 opacity-70 lg:block" rotate={20} />
    </span>
  </div>
</section>
