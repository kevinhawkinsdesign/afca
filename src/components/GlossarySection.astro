---
// Every term here is an established, real industry acronym or standard —
// no invented terminology, per BRIEF.md section 8's sourcing rule. Term
// names stay untranslated across locales (see i18n/glossaryContent.ts);
// only definitions and UI strings vary.
import { glossaryTerms, glossaryUi } from "../i18n/glossaryContent";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const terms = glossaryTerms[locale];
const ui = glossaryUi[locale];

const grouped = new Map<string, typeof terms>();
for (const term of terms) {
  const letter = term[0][0].toUpperCase();
  if (!grouped.has(letter)) grouped.set(letter, []);
  grouped.get(letter)!.push(term);
}
const letters = Array.from(grouped.keys()).sort();
---

<div id="glossary">
  <h2 class="font-sans text-2xl font-semibold text-ink">{ui.heading}</h2>
  <p class="mt-2 max-w-prose text-text-muted">{ui.intro}</p>

  <div class="mt-6 max-w-md">
    <label for="glossary-search" class="sr-only">{ui.heading}</label>
    <input
      id="glossary-search"
      type="search"
      placeholder={ui.searchPlaceholder}
      autocomplete="off"
      class="w-full rounded border border-rule bg-paper px-4 py-3 font-sans text-sm text-ink placeholder:text-text-muted focus:border-accent focus:outline-none"
    />
    <p id="glossary-empty" class="mt-3 hidden font-sans text-sm text-text-muted">{ui.noMatches}</p>
  </div>

  <nav aria-label="Jump to letter" class="sticky top-[57px] z-10 -mx-6 mt-6 flex flex-wrap gap-1 border-y border-rule bg-paper/95 px-6 py-3 font-mono text-xs backdrop-blur-md md:top-[65px]">
    {letters.map((letter) => (
      <a href={`#letter-${letter}`} class="rounded px-2 py-1 text-text-muted no-underline hover:bg-paper-warm hover:text-ink" data-letter-link={letter}>
        {letter}
      </a>
    ))}
  </nav>

  <div class="mt-4" data-glossary-list>
    {letters.map((letter) => (
      <div data-letter-group={letter}>
        <h3 id={`letter-${letter}`} class="scroll-mt-32 border-b border-rule pb-2 pt-8 font-sans text-lg font-semibold text-accent">
          {letter}
        </h3>
        <dl class="divide-y divide-rule">
          {grouped.get(letter)!.map(([term, definition]) => (
            <div class="py-4" data-glossary-term={term.toLowerCase()}>
              <dt class="font-sans font-semibold text-ink">{term}</dt>
              <dd class="mt-1 text-sm text-text-muted">{definition}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
</div>

<script>
  const input = document.getElementById("glossary-search") as HTMLInputElement | null;
  const empty = document.getElementById("glossary-empty");
  const groups = document.querySelectorAll<HTMLElement>("[data-letter-group]");

  if (input) {
    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      let anyVisible = false;

      groups.forEach((group) => {
        const terms = group.querySelectorAll<HTMLElement>("[data-glossary-term]");
        let groupHasMatch = false;
        terms.forEach((termEl) => {
          const text = termEl.textContent?.toLowerCase() ?? "";
          const matches = query === "" || text.includes(query);
          termEl.hidden = !matches;
          if (matches) groupHasMatch = true;
        });
        group.hidden = !groupHasMatch;
        if (groupHasMatch) anyVisible = true;
      });

      empty?.classList.toggle("hidden", anyVisible);
    });
  }
</script>
