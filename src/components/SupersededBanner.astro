---
import { withBase } from "../lib/url";
import { localizePath, type Locale } from "../i18n/config";
import { reportUi } from "../i18n/intelligenceContent";

interface Props {
  currentSlug: string;
  locale?: Locale;
}
const { currentSlug, locale = "en" } = Astro.props;
const t = reportUi[locale];
const href = locale === "en" ? withBase(`/intelligence/${currentSlug}`) : localizePath(`/intelligence/${currentSlug}`, locale);
---

<div class="superseded-banner" role="note">
  {t.supersededNotice}
  <a href={href} class="font-semibold underline">{t.viewCurrent} &rarr;</a>
</div>
