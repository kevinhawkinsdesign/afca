---
import PhotoHero from "./PhotoHero.astro";

interface Props {
  title: string;
  image: string;
  imageAlt: string;
}
const { title, image, imageAlt } = Astro.props;
---

<div class="grid items-start gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
  <div class="order-2 lg:order-1">
    <h1 class="font-sans text-4xl font-semibold leading-[1.02] text-ink sm:text-5xl">{title}</h1>
    <div class="mt-4 max-w-prose">
      <slot />
    </div>
  </div>
  <div class="order-1 mx-auto w-full max-w-sm sm:max-w-md lg:order-2 lg:mx-0 lg:max-w-none">
    <PhotoHero src={image} alt={imageAlt} />
  </div>
</div>
