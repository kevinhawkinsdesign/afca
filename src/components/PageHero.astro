---
import HeroVisual from "./HeroVisual.astro";

interface Props {
  title: string;
  visualTitle?: string;
}
const { title, visualTitle = "Stylised network map of interoperable charging infrastructure across Africa" } = Astro.props;
---

<div class="grid items-start gap-12 lg:grid-cols-[1.1fr_0.9fr]">
  <div>
    <h1 class="font-sans text-3xl font-semibold text-ink md:text-4xl">{title}</h1>
    <div class="mt-4 max-w-prose">
      <slot />
    </div>
  </div>
  <div class="hidden lg:block">
    <HeroVisual title={visualTitle} />
  </div>
</div>
