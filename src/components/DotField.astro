---
// Scattered-node decoration between homepage sections — a restrained nod to
// the star-field dividers in thoughtbot's healthcare delivery report.
// Purely decorative: aria-hidden, no motion (respects the brand's
// "restraint over energy" rule) beyond the section's own scroll-reveal.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const dots: Array<[number, number, number]> = [
  [4, 10, 2], [22, 4, 1.5], [40, 14, 2], [58, 3, 1.5], [76, 11, 2],
  [94, 5, 1.5], [12, 20, 1.5], [50, 22, 1.5], [88, 19, 2],
];
---

<svg
  class:list={["mx-auto block h-6 w-full max-w-content opacity-60", className]}
  viewBox="0 0 100 24"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
>
  {dots.map(([cx, cy, r]) => (
    <circle cx={cx} cy={cy} r={r / 2} fill="#E0924A" />
  ))}
</svg>
