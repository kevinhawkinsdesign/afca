---
interface Props {
  title?: string;
}
const { title = "Network map illustration" } = Astro.props;
---

<svg
  viewBox="0 0 560 560"
  role="img"
  aria-label={title}
  class="h-auto w-full"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <pattern id="hv-grid" width="28" height="28" patternUnits="userSpaceOnUse">
      <path d="M28 0H0V28" fill="none" stroke="#E3DBCF" stroke-width="1" />
    </pattern>
    <radialGradient id="hv-fade" cx="50%" cy="42%" r="65%">
      <stop offset="0%" stop-color="#FAF8F4" stop-opacity="0" />
      <stop offset="100%" stop-color="#FAF8F4" stop-opacity="1" />
    </radialGradient>
  </defs>

  <rect width="560" height="560" fill="url(#hv-grid)" />
  <rect width="560" height="560" fill="url(#hv-fade)" />

  <!-- simplified African continent silhouette, stylised -->
  <path
    d="M 240 60
       C 300 55, 340 75, 355 110
       C 375 130, 410 128, 425 155
       C 440 182, 420 205, 430 235
       C 445 265, 470 275, 465 310
       C 460 345, 425 350, 415 385
       C 405 420, 420 450, 395 480
       C 375 505, 345 500, 330 475
       C 315 450, 320 420, 300 400
       C 270 415, 245 405, 235 375
       C 200 370, 175 345, 180 310
       C 155 295, 140 265, 155 235
       C 140 210, 150 180, 175 165
       C 170 135, 190 105, 220 90
       C 210 75, 220 62, 240 60 Z"
    fill="none"
    stroke="#14322B"
    stroke-width="2.5"
    stroke-linejoin="round"
    opacity="0.85"
  />

  <!-- network nodes across the continent, connected -->
  <g stroke="#C8792F" stroke-width="1.5" opacity="0.8">
    <line x1="245" y1="140" x2="330" y2="180" />
    <line x1="330" y1="180" x2="300" y2="270" />
    <line x1="300" y1="270" x2="240" y2="330" />
    <line x1="240" y1="330" x2="310" y2="400" />
    <line x1="330" y1="180" x2="390" y2="230" />
    <line x1="390" y1="230" x2="300" y2="270" />
    <line x1="245" y1="140" x2="210" y2="220" />
    <line x1="210" y1="220" x2="240" y2="330" />
  </g>

  <g fill="#14322B">
    <circle cx="245" cy="140" r="6" />
    <circle cx="330" cy="180" r="7" />
    <circle cx="390" cy="230" r="5" />
    <circle cx="300" cy="270" r="8" />
    <circle cx="210" cy="220" r="5" />
    <circle cx="240" cy="330" r="7" />
    <circle cx="310" cy="400" r="6" />
  </g>
  <g fill="#C8792F">
    <circle cx="300" cy="270" r="3.5" />
    <circle cx="330" cy="180" r="3" />
  </g>

  <!-- charging bolt motif, off to the side -->
  <path
    d="M 455 385 L 430 430 L 448 430 L 435 470 L 470 420 L 452 420 Z"
    fill="#C8792F"
    opacity="0.9"
  />
</svg>
