---
import AnimatedBattery from "./decor/AnimatedBattery.astro";
import { homeContent } from "../i18n/homeContent";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeContent[locale];

// Every figure here carries a source, per AfCA's own sourcing standard
// (BRIEF.md section 8) — these are placeholder-quality citations (no
// access date tracked yet) pending the real Index data pipeline, but
// the numbers themselves are real published figures, not invented.
const stats: Array<[string, string, string]> = [
  ["17%", t.stat1Label, t.stat1Source],
  ["53.9%", t.stat2Label, t.stat2Source],
  ["93", t.stat3Label, t.stat3Source],
];

// Same page-local numbered-footnote pattern as the Intelligence page: a
// small marker in place of each inline "Source:" line, with the full
// citations collapsed (by identical text) and listed once as fine print
// at the end of this section.
const footnoteIndex = new Map<string, number>();
const footnotes: string[] = [];
function cite(text: string): number {
  if (!footnoteIndex.has(text)) {
    footnotes.push(text);
    footnoteIndex.set(text, footnotes.length);
  }
  return footnoteIndex.get(text)!;
}
---

<section>
  <div class="reveal mx-auto max-w-content px-6 py-10 md:py-16">
    <div class="flex items-center gap-3">
      <p class="eyebrow">{t.statsEyebrow}</p>
      <AnimatedBattery />
    </div>
    <div class="mt-6 grid gap-8 sm:grid-cols-3 sm:gap-6">
      {stats.map(([number, label, source]) => (
        <div>
          <p class="font-accentSerif text-5xl italic text-ink sm:text-6xl">{number}</p>
          <span class="stat-bar mt-3 block h-0.5 w-12 bg-accent"></span>
          <p class="mt-3 max-w-[22rem] text-text">{label}</p>
          <p class="mt-2 font-mono text-xs text-text-muted"><a href={`#home-src-${cite(source)}`} class="text-accent hover:underline">[{cite(source)}]</a></p>
        </div>
      ))}
    </div>
    <ol class="mt-8 space-y-1 font-mono text-xs text-text-muted">
      {footnotes.map((text, i) => (
        <li id={`home-src-${i + 1}`} class="scroll-mt-32">{i + 1}. {text}</li>
      ))}
    </ol>
  </div>
</section>
