---
import { getCollection } from "astro:content";
import { localizePath, type Locale } from "../i18n/config";
import PageHero from "./PageHero.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// News is English-only content today; non-English locale pages render this
// same list with BaseLayout's fallback notice rather than an empty page.
const entries = (await getCollection("news", (e) => e.data.locale === "en")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<section class="mx-auto max-w-content px-6 py-16">
  <PageHero title="News" visualTitle="Stylised network map illustrating AfCA's publishing cadence" />
  <div class="mt-14 space-y-6">
    {entries.map((entry) => (
      <a
        href={localizePath(`/news/${entry.slug}`, locale)}
        class="block rounded border border-rule bg-paper p-6 no-underline hover:border-ink"
      >
        <p class="font-sans text-xs font-medium uppercase tracking-wide text-text-muted">
          {entry.data.publishDate.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
        </p>
        <h2 class="mt-2 font-sans text-lg font-semibold text-ink">{entry.data.title}</h2>
        <p class="mt-2 text-sm text-text-muted">{entry.data.summary}</p>
      </a>
    ))}
  </div>
</section>
