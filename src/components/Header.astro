---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { ui, localizePath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = ui[locale];

const links: Array<[string, string]> = [
  [t.nav.about, "/about"],
  [t.nav.intelligence, "/intelligence"],
  [t.nav.standards, "/standards"],
  [t.nav.summit, "/summit"],
  [t.nav.community, "/community"],
  [t.nav.news, "/news"],
];
---

<header class="border-b border-rule bg-paper">
  <div class="mx-auto flex max-w-content items-center justify-between gap-6 px-6 py-4">
    <a href={localizePath("/", locale)} class="font-sans text-base font-semibold text-ink no-underline">
      African Charging Alliance
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-6 font-sans text-sm md:flex">
      {links.map(([label, href]) => (
        <a href={localizePath(href, locale)} class="text-text hover:text-ink no-underline">
          {label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <a
        href={localizePath("/contact", locale)}
        class="hidden rounded border border-ink px-3 py-1.5 font-sans text-sm font-medium text-ink no-underline hover:bg-ink hover:text-paper md:inline-block"
      >
        {t.nav.contact}
      </a>
      <LanguageSwitcher locale={locale} pathname={pathname} />
    </div>
  </div>
  <nav aria-label="Primary" class="flex flex-wrap gap-x-4 gap-y-2 border-t border-rule px-6 py-3 font-sans text-sm md:hidden">
    {links.map(([label, href]) => (
      <a href={localizePath(href, locale)} class="text-text no-underline">{label}</a>
    ))}
    <a href={localizePath("/contact", locale)} class="text-ink no-underline">{t.nav.contact}</a>
  </nav>
</header>
