---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { ui, localizePath, type Locale } from "../i18n/config";
import { withBase } from "../lib/url";

interface Props {
  locale: Locale;
  pathname: string;
  technicalEnglishOnly?: boolean;
}

const { locale, pathname, technicalEnglishOnly = false } = Astro.props;
const t = ui[locale];

// Intelligence and Standards are intentionally English-only technical
// content (BRIEF.md section 5) with no locale-prefixed routes — link them
// straight to their English URL rather than through localizePath, which
// would point at a non-existent /fr/intelligence, /fr/standards, etc.
const links: Array<[string, string, boolean]> = [
  [t.nav.about, "/about", false],
  [t.nav.intelligence, "/intelligence", true],
  [t.nav.standards, "/standards", true],
  [t.nav.community, "/community", false],
];

function navHref(href: string, englishOnly: boolean): string {
  return englishOnly ? withBase(href) : localizePath(href, locale);
}

const navLinkClass =
  "relative text-text no-underline transition-colors hover:text-ink after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-accent after:transition-[width] after:duration-300 hover:after:w-full";
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-content items-center justify-between gap-6 px-6 py-4">
    <a href={localizePath("/", locale)} class="font-sans text-base font-semibold tracking-tight text-ink no-underline">
      African Charging Alliance
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-7 font-sans text-sm md:flex">
      {links.map(([label, href, englishOnly]) => (
        <a href={navHref(href, englishOnly)} class={navLinkClass}>
          {label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <LanguageSwitcher locale={locale} pathname={pathname} technicalEnglishOnly={technicalEnglishOnly} />
    </div>
  </div>
  <nav aria-label="Primary" class="flex flex-wrap border-t border-rule px-3 py-1 font-sans text-sm md:hidden">
    {links.map(([label, href, englishOnly]) => (
      <a href={navHref(href, englishOnly)} class="inline-flex items-center px-3 py-3 text-text no-underline">{label}</a>
    ))}
  </nav>
</header>
