---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import BatteryScrollIndicator from "./BatteryScrollIndicator.astro";
import { ui, localizePath, type Locale } from "../i18n/config";
import { withBase } from "../lib/url";

interface Props {
  locale: Locale;
  pathname: string;
  technicalEnglishOnly?: boolean;
}

const { locale, pathname, technicalEnglishOnly = false } = Astro.props;
const t = ui[locale];

const links: Array<[string, string, boolean]> = [
  [t.nav.about, "/about", false],
  [t.nav.intelligence, "/intelligence", false],
  [t.nav.standards, "/standards", false],
  [t.nav.community, "/community", false],
];

function navHref(href: string, englishOnly: boolean): string {
  return englishOnly ? withBase(href) : localizePath(href, locale);
}

// Borderless "button" treatment: a generous pill hit area with a soft
// background on hover/focus rather than an underline — bigger, easier
// to land a tap or click on than a plain text link, with no visible
// border to keep it light.
const navLinkClass =
  "rounded-full px-4 py-3 text-text no-underline transition-colors hover:bg-paper-warm hover:text-ink focus-visible:bg-paper-warm";
// Same pill treatment, but square-ish padding for an icon-only link.
const homeLinkClass =
  "flex items-center justify-center rounded-full p-3 text-text no-underline transition-colors hover:bg-paper-warm hover:text-ink focus-visible:bg-paper-warm";
// Tighter mobile variants — smaller hit area and gap so every item (including
// longer translated labels, e.g. Kinyarwanda "Ubushakashatsi") fits on one
// row rather than wrapping to a second line. flex-nowrap + overflow-x-auto
// on the parent is the guarantee: if a very narrow viewport still can't fit
// everything, the row scrolls horizontally instead of wrapping.
const mobileNavLinkClass =
  "shrink-0 whitespace-nowrap rounded-full px-2.5 py-2 text-text no-underline transition-colors hover:bg-paper-warm hover:text-ink focus-visible:bg-paper-warm";
const mobileHomeLinkClass =
  "flex shrink-0 items-center justify-center rounded-full p-2 text-text no-underline transition-colors hover:bg-paper-warm hover:text-ink focus-visible:bg-paper-warm";
const homeHref = localizePath("/", locale);
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-content items-center justify-between gap-6 px-6 py-3">
    <a href={homeHref} class="flex items-center gap-2.5 font-sans text-base font-semibold tracking-tight text-ink no-underline">
      <img src={withBase("/logo.png")} alt="" width="32" height="32" class="h-8 w-8" />
      <span>African Charging Alliance</span>
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-1 font-sans text-sm md:flex">
      <a href={homeHref} class={homeLinkClass} aria-label={t.nav.home} title={t.nav.home}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 11.5 12 4l9 7.5" />
          <path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" />
        </svg>
      </a>
      {links.map(([label, href, englishOnly]) => (
        <a href={navHref(href, englishOnly)} class={navLinkClass}>
          {label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <BatteryScrollIndicator />
      <LanguageSwitcher locale={locale} pathname={pathname} technicalEnglishOnly={technicalEnglishOnly} />
    </div>
  </div>
  <nav aria-label="Primary" class="flex flex-nowrap items-center gap-0.5 overflow-x-auto border-t border-rule px-2 py-1.5 font-sans text-[13px] md:hidden">
    <a href={homeHref} class={mobileHomeLinkClass} aria-label={t.nav.home} title={t.nav.home}>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 11.5 12 4l9 7.5" />
        <path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" />
      </svg>
    </a>
    {links.map(([label, href, englishOnly]) => (
      <a href={navHref(href, englishOnly)} class={mobileNavLinkClass}>{label}</a>
    ))}
  </nav>
</header>
