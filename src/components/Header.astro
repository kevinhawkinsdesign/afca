---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import BatteryScrollIndicator from "./BatteryScrollIndicator.astro";
import { ui, localizePath, type Locale } from "../i18n/config";
import { withBase } from "../lib/url";

interface Props {
  locale: Locale;
  pathname: string;
  technicalEnglishOnly?: boolean;
}

const { locale, pathname, technicalEnglishOnly = false } = Astro.props;
const t = ui[locale];

const links: Array<[string, string, boolean]> = [
  [t.nav.about, "/about", false],
  [t.nav.intelligence, "/intelligence", false],
  [t.nav.standards, "/standards", false],
  [t.nav.community, "/community", false],
];

function navHref(href: string, englishOnly: boolean): string {
  return englishOnly ? withBase(href) : localizePath(href, locale);
}

// Borderless "button" treatment: a generous pill hit area with a soft
// background on hover/focus rather than an underline — bigger, easier
// to land a tap or click on than a plain text link, with no visible
// border to keep it light.
const navLinkClass =
  "rounded-full px-4 py-3 text-text no-underline transition-colors hover:bg-paper-warm hover:text-ink focus-visible:bg-paper-warm";
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-content items-center justify-between gap-6 px-6 py-3">
    <a href={localizePath("/", locale)} class="font-sans text-base font-semibold tracking-tight text-ink no-underline">
      African Charging Alliance
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-1 font-sans text-sm md:flex">
      {links.map(([label, href, englishOnly]) => (
        <a href={navHref(href, englishOnly)} class={navLinkClass}>
          {label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <BatteryScrollIndicator />
      <LanguageSwitcher locale={locale} pathname={pathname} technicalEnglishOnly={technicalEnglishOnly} />
    </div>
  </div>
  <nav aria-label="Primary" class="flex flex-wrap gap-1 border-t border-rule px-3 py-2 font-sans text-sm md:hidden">
    {links.map(([label, href, englishOnly]) => (
      <a href={navHref(href, englishOnly)} class={navLinkClass}>{label}</a>
    ))}
  </nav>
</header>
