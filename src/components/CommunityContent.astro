---
import FullBleedHero from "./FullBleedHero.astro";
import FullBleedBreak from "./FullBleedBreak.astro";
import { withBase } from "../lib/url";
import { communityContent } from "../i18n/communityContent";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = communityContent[locale];
---

<FullBleedHero title={t.heroTitle} image="/hero/community.jpg" imageAlt="An electric bus charging at a depot in Kenya">
  <p class="text-lg text-text">{t.heroIntro}</p>
</FullBleedHero>

<section class="mx-auto max-w-content px-6 py-10 md:py-16">
  <h2 class="font-sans text-2xl font-semibold text-ink">{t.membershipHeading}</h2>
  <p class="mt-4 max-w-prose text-text-muted">
    {/* TODO: membership tiers, fees, and eligibility criteria — pending governance sign-off. */}
    {t.membershipTextPre}{" "}
    <a href={withBase("/about")} class="text-ink underline">{t.membershipLink}</a>{t.membershipTextPost}
  </p>

  <h2 class="mt-14 font-sans text-2xl font-semibold text-ink">{t.workingGroupsHeading}</h2>
  <p class="mt-4 max-w-prose text-text-muted">
    {/* TODO: list active working groups once formally constituted. */}
    {t.workingGroupsText}
  </p>

  <h2 class="mt-14 font-sans text-2xl font-semibold text-ink">{t.directoryHeading}</h2>
  <p class="mt-4 max-w-prose text-text-muted">
    {/* TODO: populate with confirmed participants. No customer-showcase framing — factual data points only, per BRIEF.md section 8. */}
    {t.directoryText}
  </p>

  <FullBleedBreak image="/hero/summit.jpg" imageAlt="Nairobi skyline at dusk" caption={t.breakCaption} />

  <h2 id="summit" class="scroll-mt-24 font-sans text-2xl font-semibold text-ink">{t.summitHeading}</h2>
  <p class="mt-4 max-w-prose text-lg text-text">{t.summitIntro}</p>

  <h3 class="mt-10 font-sans text-xl font-semibold text-ink">{t.summitPurposeHeading}</h3>
  <p class="mt-4 max-w-prose text-text">{t.summitPurposeText}</p>

  <h3 class="mt-10 font-sans text-xl font-semibold text-ink">{t.datesHeading}</h3>
  <p class="mt-4 max-w-prose text-text-muted">
    {/* TODO: confirm dates, city, and venue once finalised. */}
    {t.datesText}
  </p>

  <h3 class="mt-10 font-sans text-xl font-semibold text-ink">{t.participationHeading}</h3>
  <p class="mt-4 max-w-prose text-text-muted">
    {/* TODO: registration process and criteria. */}
    {t.participationText}
  </p>
</section>
