---
import DotField from "./DotField.astro";
import ElectricDivider from "./decor/ElectricDivider.astro";
import { withBase } from "../lib/url";
import { homeContent } from "../i18n/homeContent";
import { localizePath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeContent[locale];

// Standards and Intelligence are deliberately English-only technical
// content (see the matching comment in Header.astro) — link straight to
// the English URL. Community is fully translated, so localize it.
const sections: Array<[string, string, string, boolean]> = [
  ["/standards", t.explore1Title, t.explore1Body, true],
  ["/intelligence", t.explore2Title, t.explore2Body, true],
  ["/community", t.explore3Title, t.explore3Body, false],
];
---

<ElectricDivider />
<section>
  <div class="mx-auto max-w-content px-6 py-10 md:py-16">
    <p class="reveal eyebrow text-center">{t.exploreEyebrow}</p>
    <DotField class="reveal mt-4" />
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {sections.map(([href, title, summary, englishOnly], i) => (
        <a
          href={englishOnly ? withBase(href) : localizePath(href, locale)}
          class:list={[
            "reveal group block rounded border border-rule bg-paper p-6 no-underline transition-all duration-300 hover:-translate-y-1 hover:border-accent/70 hover:shadow-lg hover:shadow-accent/20",
            i === 1 ? "reveal-delay-1" : i === 2 ? "reveal-delay-2" : "",
          ]}
        >
          <h3 class="font-sans text-lg font-semibold text-ink">{title}</h3>
          <p class="mt-2 text-sm text-text-muted">{summary}</p>
          <span class="eyebrow mt-4 inline-flex items-center gap-2 text-text-muted group-hover:text-accent">
            {t.visit}
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
