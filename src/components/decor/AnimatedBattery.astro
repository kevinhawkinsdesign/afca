---
// A small looping charging-battery icon — decorative reinforcement of
// the site's electric/charging motif, distinct from the functional
// scroll-progress battery in the header.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg class:list={["battery-decor pointer-events-none", className]} width="28" height="16" viewBox="0 0 28 16" fill="none" aria-hidden="true">
  <rect x="1" y="1" width="22" height="14" rx="2.5" stroke="#9C9384" stroke-width="1.2" />
  <rect x="24" y="5" width="2.5" height="6" rx="1" fill="#9C9384" />
  <rect x="3" y="3" width="18" height="10" rx="1" fill="none" />
  <rect class="battery-decor__fill" x="3" y="3" width="4" height="10" rx="1" fill="#E0924A" />
</svg>

<style>
  .battery-decor__fill {
    animation: battery-decor-charge 3.2s ease-in-out infinite;
    transform-origin: left;
  }
  @keyframes battery-decor-charge {
    0%, 100% { width: 4px; opacity: 0.6; }
    50% { width: 18px; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .battery-decor__fill {
      animation: none;
      width: 14px;
    }
  }
</style>
