---
import BaseLayout from "../layouts/BaseLayout.astro";
import CommunityContent from "../components/CommunityContent.astro";
import { isHidden } from "../lib/hiddenSections";
import { localizePath } from "../i18n/config";

const locale = "en" as const;

if (isHidden("/community")) return Astro.redirect(localizePath("/", locale), 307);
---

<BaseLayout
  image="/hero/community.jpg" locale={locale} title="Community" description="Membership, working groups, the AfCA participant directory, and the AfCA Annual Summit.">
  <CommunityContent locale={locale} />
</BaseLayout>
