---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeHero from "../../components/HomeHero.astro";
import HomeMission from "../../components/HomeMission.astro";
import HomeFounders from "../../components/HomeFounders.astro";
import HomeStats from "../../components/HomeStats.astro";
import HomeInitiatives from "../../components/HomeInitiatives.astro";
import HomeExplore from "../../components/HomeExplore.astro";
import PageFootnotes from "../../components/PageFootnotes.astro";
import { homeContent } from "../../i18n/homeContent";
import { prefixedLocales } from "../../i18n/config";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: (typeof prefixedLocales)[number] };
const t = homeContent[locale];

// Shared citation registry for this page — see the English index.astro
// for the full explanation.
const footnotes: Array<{ text: string; href?: string }> = [];
const footnoteIndex = new Map<string, number>();
function cite(text: string, href?: string): number {
  if (!footnoteIndex.has(text)) {
    footnotes.push({ text, href });
    footnoteIndex.set(text, footnotes.length);
  }
  return footnoteIndex.get(text)!;
}
---

<BaseLayout
  locale={locale}
  title="Home"
  description="African Charging Alliance is an independent, non-profit trade association and ecosystem platform accelerating interoperable EV charging infrastructure across Africa. Registration in Rwanda is in progress."
>
  <HomeHero locale={locale} />
  <HomeMission locale={locale} />
  <HomeFounders locale={locale} />
  <HomeStats locale={locale} cite={cite} />
  <HomeInitiatives locale={locale} cite={cite} />
  <HomeExplore locale={locale} />
  <PageFootnotes footnotes={footnotes} heading={t.sourcesHeading} idPrefix="page-src" />
</BaseLayout>
