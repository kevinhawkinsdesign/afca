---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CommunityContent from "../../components/CommunityContent.astro";
import { prefixedLocales } from "../../i18n/config";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: (typeof prefixedLocales)[number] };
---

<BaseLayout
  locale={locale}
  title="Community"
  description="Membership, working groups, and the AfCA participant directory."
  isFallback={true}
>
  <CommunityContent />
</BaseLayout>
