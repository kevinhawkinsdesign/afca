---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NewsArticle from "../../../components/NewsArticle.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { prefixedLocales } from "../../../i18n/config";

export async function getStaticPaths() {
  const entries = await getCollection("news", (e) => e.data.locale === "en");
  const paths: { params: { locale: string; slug: string }; props: { entry: CollectionEntry<"news"> } }[] = [];
  for (const locale of prefixedLocales) {
    for (const entry of entries) {
      paths.push({ params: { locale, slug: entry.slug }, props: { entry } });
    }
  }
  return paths;
}

interface Props {
  entry: CollectionEntry<"news">;
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: (typeof prefixedLocales)[number] };
const { Content } = await entry.render();
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.summary} isFallback={true}>
  <NewsArticle entry={entry} Content={Content} />
</BaseLayout>
