---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NewsIndexList from "../../../components/NewsIndexList.astro";
import { prefixedLocales } from "../../../i18n/config";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: (typeof prefixedLocales)[number] };
---

<BaseLayout locale={locale} title="News" description="AfCA news and publishing cadence." isFallback={true}>
  <NewsIndexList locale={locale} />
</BaseLayout>
