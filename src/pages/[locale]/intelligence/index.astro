---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntelligenceIndexContent from "../../../components/IntelligenceIndexContent.astro";
import { prefixedLocales, localizePath } from "../../../i18n/config";
import { isHidden } from "../../../lib/hiddenSections";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: (typeof prefixedLocales)[number] };

if (isHidden("/intelligence")) return Astro.redirect(localizePath("/", locale), 307);
---

<BaseLayout
  image="/hero/intelligence.jpg"
  locale={locale}
  title="Intelligence"
  description="A curated, sourced collection of public statistics on EV charging infrastructure across Africa."
>
  <IntelligenceIndexContent locale={locale} />
</BaseLayout>
