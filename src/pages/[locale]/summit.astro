---
import { localizePath, prefixedLocales } from "../../i18n/config";
import { isHidden } from "../../lib/hiddenSections";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: (typeof prefixedLocales)[number] };

// The Summit is now a section on /community (site consolidated to 5
// primary pages). Redirect anyone with the old URL bookmarked, or send
// them home while /community is hidden.
if (isHidden("/community")) return Astro.redirect(localizePath("/", locale), 307);
return Astro.redirect(`${localizePath("/community", locale)}#summit`, 308);
---
