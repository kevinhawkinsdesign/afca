---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactContent from "../../components/ContactContent.astro";
import { prefixedLocales } from "../../i18n/config";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: (typeof prefixedLocales)[number] };
---

<BaseLayout
  locale={locale}
  title="Contact"
  description="Get in touch with African Charging Alliance."
  isFallback={true}
>
  <ContactContent />
</BaseLayout>
