---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StandardsIndexContent from "../../../components/StandardsIndexContent.astro";
import { prefixedLocales } from "../../../i18n/config";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: (typeof prefixedLocales)[number] };
---

<BaseLayout
  image="/hero/standards.jpg" locale={locale} title="Standards">
  <StandardsIndexContent locale={locale} />
</BaseLayout>
