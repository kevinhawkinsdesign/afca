---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StandardsIndexContent from "../../components/StandardsIndexContent.astro";
import { isHidden } from "../../lib/hiddenSections";
import { localizePath } from "../../i18n/config";

const locale = "en" as const;

if (isHidden("/standards")) return Astro.redirect(localizePath("/", locale), 307);
---

<BaseLayout
  image="/hero/standards.jpg" locale={locale} title="Standards">
  <StandardsIndexContent locale={locale} />
</BaseLayout>
