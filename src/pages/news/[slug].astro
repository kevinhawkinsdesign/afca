---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsArticle from "../../components/NewsArticle.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("news", (e) => e.data.locale === "en");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"news">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const locale = "en" as const;
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.summary}>
  <NewsArticle entry={entry} Content={Content} />
</BaseLayout>
