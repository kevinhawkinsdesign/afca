---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { getCollection } from "astro:content";

const locale = "en" as const;

const allEntries = await getCollection("intelligence", (e) => e.data.locale === locale);
// Hide superseded entries from the index — they stay reachable at their
// own URL with a banner pointing to the current version, per BRIEF.md
// section 6, but the landing page should surface only current guidance.
const supersededSlugs = new Set(
  allEntries.filter((e) => e.data.supersededBy).map((e) => e.slug),
);
const visible = allEntries
  .filter((e) => !supersededSlugs.has(e.slug))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  locale={locale}
  title="Intelligence"
  description="Ecosystem intelligence, country overviews, and the Pan-African Interoperability and Reliability Index."
  technicalEnglishOnly={true}
>
  <section class="mx-auto max-w-content px-6 py-16">
    <PageHero title="Intelligence" visualTitle="Stylised network map illustrating AfCA's ecosystem intelligence coverage">
      <p class="text-lg text-text">
        Country-by-country market mapping and the Pan-African Interoperability and Reliability
        Index. Every figure carries a source; superseded reports stay published with a link to the
        current version rather than being deleted.
      </p>
    </PageHero>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {visible.map((entry) => (
        <a href={`/intelligence/${entry.slug}`} class="block rounded border border-rule bg-paper p-6 no-underline hover:border-ink">
          <p class="font-sans text-xs font-medium uppercase tracking-wide text-text-muted">
            {entry.data.publishDate.toLocaleDateString("en-GB", { year: "numeric", month: "long" })}
            &middot; v{entry.data.methodologyVersion}
          </p>
          <h2 class="mt-2 font-sans text-lg font-semibold text-ink">{entry.data.title}</h2>
          <p class="mt-2 text-sm text-text-muted">{entry.data.summary}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
