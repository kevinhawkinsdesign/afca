---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScopeNote from "../../components/ScopeNote.astro";
import SupersededBanner from "../../components/SupersededBanner.astro";
import SourceList from "../../components/SourceList.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { withBase } from "../../lib/url";
import HeroVisual from "../../components/HeroVisual.astro";

export async function getStaticPaths() {
  const entries = await getCollection("intelligence", (e) => e.data.locale === "en");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"intelligence">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const locale = "en" as const;
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.summary}
  technicalEnglishOnly={true}
>
  <article class="px-6 py-10 md:py-16">
    <div class="mx-auto grid max-w-content items-start gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:gap-10">
      <div class="order-1 max-w-prose">
        <p class="mb-2 font-sans text-sm font-medium uppercase tracking-wide text-accent">
          <a href={withBase("/intelligence")} class="no-underline text-accent">Intelligence</a>
        </p>
        <h1 class="font-sans text-3xl font-semibold text-ink">{entry.data.title}</h1>
        <p class="mt-2 font-sans text-sm text-text-muted">
          {entry.data.publishDate.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
          &middot; Methodology v{entry.data.methodologyVersion}
        </p>
      </div>
      <div class="order-2 mx-auto w-full max-w-[12rem] sm:max-w-[14rem] lg:order-2 lg:mx-0 lg:max-w-xs lg:justify-self-end">
        <HeroVisual title={`Stylised benchmarking chart illustration for: ${entry.data.title}`} variant="data" />
      </div>
    </div>

    <div class="mx-auto max-w-prose">
      {entry.data.supersededBy && (
        <div class="mt-6">
          <SupersededBanner currentSlug={entry.data.supersededBy} />
        </div>
      )}

      <div class="mt-6">
        <ScopeNote scopeNote={entry.data.scopeNote} methodologyVersion={entry.data.methodologyVersion} />
      </div>

      <div class="prose-guide">
        <Content />
      </div>

      <SourceList sources={entry.data.sources} />
    </div>
  </article>
</BaseLayout>
