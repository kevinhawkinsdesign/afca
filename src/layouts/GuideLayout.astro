---
import BaseLayout from "./BaseLayout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import { withBase } from "../lib/url";
import { localizePath, type Locale } from "../i18n/config";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  standardsLabel?: string;
}
const { title, description, locale = "en", standardsLabel = "Standards & Implementation Guidance" } = Astro.props;
const standardsHref = locale === "en" ? withBase("/standards") : localizePath("/standards", locale);
---

<BaseLayout locale={locale} title={title} description={description}>
  <article class="px-6 py-10 md:py-16">
    <div class="mx-auto grid max-w-content items-start gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:gap-10">
      <div class="order-1 max-w-prose">
        <p class="mb-2 eyebrow">
          <a href={standardsHref} class="no-underline text-accent">{standardsLabel}</a>
        </p>
        <h1 class="font-sans text-3xl font-semibold text-ink">{title}</h1>
        <p class="mt-4 text-lg text-text">{description}</p>
      </div>
      <div class="order-2 mx-auto w-full max-w-[12rem] sm:max-w-[14rem] lg:order-2 lg:mx-0 lg:max-w-xs lg:justify-self-end">
        <PhotoHero src="/hero/standards.jpg" alt="A motorcycle taxi rider using a ROAM fast charger in Kenya" compact />
      </div>
    </div>
    <div class="mx-auto max-w-prose">
      <div class="prose-guide mt-10">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
