---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ui, localeNames, type Locale } from "../i18n/config";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /**
   * Set when this page is rendering the English fallback because no
   * translation exists yet for `locale`. Triggers the visible notice
   * required by BRIEF.md section 5 — never fall back silently.
   */
  isFallback?: boolean;
  /** Set for English-only technical pages (Index methodology, standards guidance). */
  technicalEnglishOnly?: boolean;
}

const { locale, title, description, isFallback = false, technicalEnglishOnly = false } = Astro.props;
const t = ui[locale];
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#10201B" />
    <title>{title} — African Charging Alliance</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress></div>
    <a href="#main" class="skip-link">{t.skipToContent}</a>
    <Header locale={locale} pathname={pathname} technicalEnglishOnly={technicalEnglishOnly} />
    <main id="main">
      {isFallback && (
        <div class="mx-auto max-w-content px-6 pt-8">
          <p class="locale-notice" role="status">
            {t.notTranslatedNotice(localeNames[locale])}
          </p>
        </div>
      )}
      {technicalEnglishOnly && locale === "en" && (
        <div class="mx-auto max-w-content px-6 pt-8">
          <p class="locale-notice" role="note">{t.technicalEnglishNotice}</p>
        </div>
      )}
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const bar = document.querySelector<HTMLElement>("[data-scroll-progress]");
      if (bar && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const update = () => {
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          const pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
          bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
        };
        document.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
      }
    </script>
    <script>
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (revealEls.length) {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          revealEls.forEach((el) => el.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
          );
          revealEls.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
