      posthog.init('phc_qs7wVykPckqoUtsPKUzKgvZ4e6LEUnc8gY8dakL2YCxL', {
        api_host: 'https://eu.i.posthog.com',
        defaults: '2026-05-30',
        person_profiles: 'identified_only',
      })
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0A" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("/favicon-16.png")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />

    {/* Hreflang alternates — one per locale plus x-default, so crawlers and LLMs can find every translation of this page. */}
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizePath(barePath, l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(barePath, defaultLocale), Astro.site)} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={locale} />

    {/* Twitter card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Structured data — helps search engines and LLM crawlers identify the organization and site unambiguously. */}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} is:inline />
  </head>
  <body>
    <CustomCursor />
    <a href="#main" class="skip-link">{t.skipToContent}</a>
    <EventsBanner locale={locale} />
    <Header locale={locale} pathname={pathname} technicalEnglishOnly={technicalEnglishOnly} />
    <main id="main">
      {isFallback && (
        <div class="mx-auto max-w-content px-6 pt-8">
          <p class="locale-notice" role="status">
            {t.notTranslatedNotice(localeNames[locale])}
          </p>
        </div>
      )}
      {technicalEnglishOnly && locale === "en" && (
        <div class="mx-auto max-w-content px-6 pt-8">
          <p class="locale-notice" role="note">{t.technicalEnglishNotice}</p>
        </div>
      )}
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (revealEls.length) {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          revealEls.forEach((el) => el.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
          );
          revealEls.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
