---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CustomCursor from "../components/CustomCursor.astro";
import EventsBanner from "../components/EventsBanner.astro";
import { ui, localeNames, locales, defaultLocale, localizePath, stripLocale, type Locale } from "../i18n/config";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /**
   * Set when this page is rendering the English fallback because no
   * translation exists yet for `locale`. Triggers the visible notice
   * required by BRIEF.md section 5 — never fall back silently.
   */
  isFallback?: boolean;
  /** Set for English-only technical pages (Index methodology, standards guidance). */
  technicalEnglishOnly?: boolean;
  /** Absolute-app-path (e.g. "/hero/intelligence.jpg") used for social share previews. */
  image?: string;
}

const {
  locale,
  title,
  description,
  isFallback = false,
  technicalEnglishOnly = false,
  image = "/hero/home.jpg",
} = Astro.props;
const t = ui[locale];
const pathname = Astro.url.pathname;
const barePath = stripLocale(pathname);
const canonicalURL = new URL(localizePath(barePath, locale), Astro.site);
const ogImageURL = new URL(withBase(image), Astro.site);
const siteName = "African Charging Alliance";
const fullTitle = `${title} — ${siteName}`;
const pageDescription =
  description ?? "African Charging Alliance (AfCA) is an independent, non-profit trade association advancing interoperable EV charging infrastructure across Africa.";

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  alternateName: "AfCA",
  url: "https://africancharging.org",
  logo: new URL(withBase("/logo-512.png"), Astro.site).toString(),
  description:
    "African Charging Alliance is an independent, non-profit trade association and ecosystem platform for interoperable EV charging infrastructure across Africa.",
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: "https://africancharging.org",
  inLanguage: locale,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0A" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("/favicon-16.png")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />

    {/* Hreflang alternates — one per locale plus x-default, so crawlers and LLMs can find every translation of this page. */}
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizePath(barePath, l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(barePath, defaultLocale), Astro.site)} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={locale} />

    {/* Twitter card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Structured data — helps search engines and LLM crawlers identify the organization and site unambiguously. */}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} is:inline />
  </head>
  <body>
    <CustomCursor />
    <a href="#main" class="skip-link">{t.skipToContent}</a>
    <EventsBanner locale={locale} />
    <Header locale={locale} pathname={pathname} technicalEnglishOnly={technicalEnglishOnly} />
    <main id="main">
      {isFallback && (
        <div class="mx-auto max-w-content px-6 pt-8">
          <p class="locale-notice" role="status">
            {t.notTranslatedNotice(localeNames[locale])}
          </p>
        </div>
      )}
      {technicalEnglishOnly && locale === "en" && (
        <div class="mx-auto max-w-content px-6 pt-8">
          <p class="locale-notice" role="note">{t.technicalEnglishNotice}</p>
        </div>
      )}
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (revealEls.length) {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          revealEls.forEach((el) => el.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
          );
          revealEls.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
